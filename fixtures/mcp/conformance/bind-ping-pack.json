{
  "name": "bind-ping-pack",
  "version": 1,
  "steps": [
    {
      "tool": "ping",
      "expect_contains": ["ok"]
    },
    {
      "tool": "broker_health",
      "expect_contains": ["ok", "offers", "ambient"]
    },
    {
      "tool": "catalog_list",
      "expect_contains": ["broker.health", "llm.chat"]
    },
    {
      "tool": "session_bind",
      "arguments": {
        "offer_ids": ["llm.chat"],
        "principal": "local",
        "ttl_secs": 60
      },
      "expect_contains": ["bindings", "llm.chat"]
    }
  ]
}
